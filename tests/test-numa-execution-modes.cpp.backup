// Supported NUMA operation types for testing
enum class NumaOperationType {
    ADD                 // Element-wise addition (a + b) - IMPLEMENTED
    // Add more operations here as NUMA kernels are implemented
};

// Supported NUMA strategies for testing
enum class TestNumaStrategy {
    ISOLATE_NODE_0,     // Execute only on NUMA node 0
    ISOLATE_NODE_1,     // Execute only on NUMA node 1  
    MIRROR              // Execute across all NUMA nodes
};

// Supported tensor sizes for testing
enum class TensorSize {
    SMALL,              // Small tensor (1 MB)
    LARGE,              // Large tensor (32 MB)
    HUGE                // Huge tensor (1 GB)
};

// Single test configuration
struct TestConfig {
    NumaOperationType operation;
    TestNumaStrategy strategy;
    TensorSize size;
    int dim1, dim2, dim3;
    std::string name;
    std::string description;
};

// Helper functions to convert enums to strings
std::string operation_type_to_string(NumaOperationType operation) {
    switch (operation) {
        case NumaOperationType::ADD: return "ADD";
        default: return "UNKNOWN";
    }
}

std::string strategy_to_string(TestNumaStrategy strategy) {
    switch (strategy) {
        case TestNumaStrategy::ISOLATE_NODE_0: return "ISOLATE_NODE_0";
        case TestNumaStrategy::ISOLATE_NODE_1: return "ISOLATE_NODE_1";
        case TestNumaStrategy::MIRROR: return "MIRROR";
        default: return "UNKNOWN";
    }
}

std::string size_to_string(TensorSize size) {
    switch (size) {
        case TensorSize::SMALL: return "SMALL";
        case TensorSize::LARGE: return "LARGE";
        case TensorSize::HUGE: return "HUGE";
        default: return "UNKNOWN";
    }
}

// Parse command line arguments
TestConfig parse_arguments(int argc, char* argv[]) {
    if (argc != 4) {
        printf("Usage: %s <OPERATION> <STRATEGY> <SIZE>\n", argv[0]);
        printf("  OPERATION: ADD\n");
        printf("  STRATEGY: ISOLATE_NODE_0, ISOLATE_NODE_1, MIRROR\n");
        printf("  SIZE: SMALL, LARGE, HUGE\n");
        exit(1);
    }
    
    TestConfig config = {};
    
    // Parse operation
    if (strcmp(argv[1], "ADD") == 0) {
        config.operation = NumaOperationType::ADD;
    } else {
        printf("❌ Unknown operation: %s\n", argv[1]);
        exit(1);
    }
    
    // Parse strategy
    if (strcmp(argv[2], "ISOLATE_NODE_0") == 0) {
        config.strategy = TestNumaStrategy::ISOLATE_NODE_0;
    } else if (strcmp(argv[2], "ISOLATE_NODE_1") == 0) {
        config.strategy = TestNumaStrategy::ISOLATE_NODE_1;
    } else if (strcmp(argv[2], "MIRROR") == 0) {
        config.strategy = TestNumaStrategy::MIRROR;
    } else {
        printf("❌ Unknown strategy: %s\n", argv[2]);
        exit(1);
    }
    
    // Parse size and set dimensions
    if (strcmp(argv[3], "SMALL") == 0) {
        config.size = TensorSize::SMALL;
        config.dim1 = 128; config.dim2 = 128; config.dim3 = 16;   // ~1 MB
        config.name = "ADD_SMALL";
        config.description = "Small tensor (1 MB)";
    } else if (strcmp(argv[3], "LARGE") == 0) {
        config.size = TensorSize::LARGE;
        config.dim1 = 256; config.dim2 = 256; config.dim3 = 64;   // ~32 MB
        config.name = "ADD_LARGE";  
        config.description = "Large tensor (32 MB)";
    } else if (strcmp(argv[3], "HUGE") == 0) {
        config.size = TensorSize::HUGE;
        config.dim1 = 512; config.dim2 = 512; config.dim3 = 256;  // ~1 GB
        config.name = "ADD_HUGE";
        config.description = "Huge tensor (1 GB)";
    } else {
        printf("❌ Unknown size: %s\n", argv[3]);
        exit(1);
    }
    
    return config;
}

// Setup NUMA strategy and CPU affinity
void setup_numa_strategy(TestNumaStrategy strategy) {
    switch (strategy) {
        case TestNumaStrategy::ISOLATE_NODE_0:
            printf("🔧 Setting up ISOLATE strategy for NUMA node 0\n");
            
            // Set CPU affinity to node 0
#ifdef __linux__
            {
                cpu_set_t mask;
                CPU_ZERO(&mask);
                // Bind to physical cores of NUMA node 0 (cores 0-27)
                for (int i = 0; i < 28; i++) {
                    CPU_SET(i, &mask);
                }
                if (sched_setaffinity(0, sizeof(mask), &mask) != 0) {
                    printf("❌ Failed to set CPU affinity to NUMA node 0\n");
                    exit(1);
                }
                printf("✅ CPU affinity set to NUMA node 0 (cores 0-27)\n");
            }
#endif
            
            // Initialize NUMA coordinator with ISOLATE strategy
            ggml_numa_init_with_node(GGML_NUMA_STRATEGY_ISOLATE, 0);
            setenv("GGML_NUMA_NODES", "1", 1);
            printf("✅ NUMA coordinator initialized: ISOLATE node 0\n");
            break;
            
        case TestNumaStrategy::ISOLATE_NODE_1:
            printf("🔧 Setting up ISOLATE strategy for NUMA node 1\n");
            
            // Set CPU affinity to node 1
#ifdef __linux__
            {
                cpu_set_t mask;
                CPU_ZERO(&mask);
                // Bind to physical cores of NUMA node 1 (cores 28-55)
                for (int i = 28; i < 56; i++) {
                    CPU_SET(i, &mask);
                }
                if (sched_setaffinity(0, sizeof(mask), &mask) != 0) {
                    printf("❌ Failed to set CPU affinity to NUMA node 1\n");
                    exit(1);
                }
                printf("✅ CPU affinity set to NUMA node 1 (cores 28-55)\n");
            }
#endif
            
            // Initialize NUMA coordinator with ISOLATE strategy
            ggml_numa_init_with_node(GGML_NUMA_STRATEGY_ISOLATE, 1);
            setenv("GGML_NUMA_NODES", "1", 1);
            printf("✅ NUMA coordinator initialized: ISOLATE node 1\n");
            break;
            
        case TestNumaStrategy::MIRROR:
            printf("🔧 Setting up MIRROR strategy for all NUMA nodes\n");
            
            // Clear CPU affinity (allow all cores)
#ifdef __linux__
            {
                cpu_set_t mask;
                CPU_ZERO(&mask);
                for (int i = 0; i < 112; i++) {  // All logical cores
                    CPU_SET(i, &mask);
                }
                if (sched_setaffinity(0, sizeof(mask), &mask) != 0) {
                    printf("❌ Failed to clear CPU affinity\n");
                    exit(1);
                }
                printf("✅ CPU affinity cleared (all cores available)\n");
            }
#endif
            
            // Initialize NUMA coordinator with MIRROR strategy
            ggml_numa_init(GGML_NUMA_STRATEGY_MIRROR);
            setenv("GGML_NUMA_NODES", "2", 1);
            printf("✅ NUMA coordinator initialized: MIRROR across 2 nodes\n");
            break;
    }
    
    // Verify the setup
    verify_numa_setup(strategy);
}

// Verify NUMA setup is correct
void verify_numa_setup(TestNumaStrategy strategy) {
    enum ggml_numa_strategy actual_strategy = ggml_numa_get_strategy();
    int num_nodes = ggml_numa_simple_coordinator_get_num_nodes();
    
    printf("🔍 Verifying NUMA setup...\n");
    printf("   Strategy: %d\n", actual_strategy);
    printf("   Coordinator nodes: %d\n", num_nodes);
    
    switch (strategy) {
        case TestNumaStrategy::ISOLATE_NODE_0:
        case TestNumaStrategy::ISOLATE_NODE_1:
            if (actual_strategy != GGML_NUMA_STRATEGY_ISOLATE) {
                printf("❌ Expected ISOLATE strategy (%d), got %d\n", GGML_NUMA_STRATEGY_ISOLATE, actual_strategy);
                exit(1);
            }
            if (num_nodes != 1) {
                printf("❌ Expected 1 node for ISOLATE, got %d\n", num_nodes);
                exit(1);
            }
            break;
            
        case TestNumaStrategy::MIRROR:
            if (actual_strategy != GGML_NUMA_STRATEGY_MIRROR) {
                printf("❌ Expected MIRROR strategy (%d), got %d\n", GGML_NUMA_STRATEGY_MIRROR, actual_strategy);
                exit(1);
            }
            if (num_nodes != 2) {
                printf("❌ Expected 2 nodes for MIRROR, got %d\n", num_nodes);
                exit(1);
            }
            break;
    }
    
    printf("✅ NUMA setup verification passed\n");
}

// Test result storage - updated for dynamic NUMA nodes
struct TestResult {
    std::string config_name;
    std::string description;
    double size_gb;
    std::vector<double> isolate_times_ms;  // One per NUMA node
    double mirror_time_ms;                 // All nodes together
    std::vector<double> isolate_ratios;    // Each vs first node
    double mirror_vs_best_ratio;           // Mirror vs best single node
    double numa_scaling_efficiency;       // Mirror scaling relative to node count
};

// NUMA Topology Detection
class NumaTopologyDetector {
private:
    int total_numa_nodes;
    std::vector<std::vector<int>> physical_cores_per_node;
    std::vector<int> cores_per_node;
    
public:
    NumaTopologyDetector() {
        detect_numa_topology();
    }
    
    void detect_numa_topology() {
#ifdef __linux__
        if (numa_available() < 0) {
            printf("⚠️  NUMA not available, using single-node fallback\n");
            total_numa_nodes = 1;
            int total_cores = static_cast<int>(sysconf(_SC_NPROCESSORS_ONLN));
            cores_per_node = {total_cores};
            physical_cores_per_node = {{}};
            for (int i = 0; i < cores_per_node[0]; i++) {
                physical_cores_per_node[0].push_back(i);
            }
            return;
        }
        
        total_numa_nodes = numa_max_node() + 1;
        printf("🔍 Detecting NUMA topology: %d nodes available\n", total_numa_nodes);
        
        cores_per_node.resize(total_numa_nodes);
        physical_cores_per_node.resize(total_numa_nodes);
        
        for (int node = 0; node < total_numa_nodes; node++) {
            detect_physical_cores_for_node(node);
            printf("   📍 NUMA Node %d: %d physical cores detected\n", 
                   node, (int)physical_cores_per_node[node].size());
        }
#else
        // Non-Linux fallback
        total_numa_nodes = 1;
        int total_cores = static_cast<int>(sysconf(_SC_NPROCESSORS_ONLN));
        cores_per_node = {total_cores};
        physical_cores_per_node = {{}};
        for (int i = 0; i < cores_per_node[0]; i++) {
            physical_cores_per_node[0].push_back(i);
        }
#endif
    }
    
    void detect_physical_cores_for_node(int node) {
#ifdef __linux__
        struct bitmask* cpu_mask = numa_bitmask_alloc(numa_num_possible_cpus());
        numa_node_to_cpus(node, cpu_mask);
        
        std::vector<int> node_cpus;
        for (int cpu = 0; cpu < numa_num_possible_cpus(); cpu++) {
            if (numa_bitmask_isbitset(cpu_mask, cpu)) {
                node_cpus.push_back(cpu);
            }
        }
        
        numa_bitmask_free(cpu_mask);
        
        // Now detect physical cores using thread siblings (similar to coordinator logic)
        std::set<std::string> seen_sibling_groups;
        
        for (int cpu : node_cpus) {
            char thread_siblings_path[256];
            snprintf(thread_siblings_path, sizeof(thread_siblings_path), 
                     "/sys/devices/system/cpu/cpu%d/topology/thread_siblings_list", cpu);
            
            FILE* siblings_file = fopen(thread_siblings_path, "r");
            char siblings_line[256] = {0};
            bool is_primary = true;
            
            if (siblings_file) {
                if (fgets(siblings_line, sizeof(siblings_line), siblings_file)) {
                    // Remove newline
                    siblings_line[strcspn(siblings_line, "\n")] = 0;
                    
                    // Check if we've seen this sibling group before
                    if (seen_sibling_groups.find(siblings_line) != seen_sibling_groups.end()) {
                        is_primary = false; // This is a hyperthread, not primary core
                    } else {
                        seen_sibling_groups.insert(siblings_line);
                        is_primary = true; // First time seeing this group = primary core
                    }
                }
                fclose(siblings_file);
            }
            
            if (is_primary) {
                physical_cores_per_node[node].push_back(cpu);
            }
        }
        
        cores_per_node[node] = physical_cores_per_node[node].size();
#else
        // Fallback: assume all CPUs are physical cores
        int total_cores = static_cast<int>(sysconf(_SC_NPROCESSORS_ONLN));
        cores_per_node[node] = total_cores / total_numa_nodes;
        physical_cores_per_node[node].resize(cores_per_node[node]);
        for (int i = 0; i < cores_per_node[node]; i++) {
            physical_cores_per_node[node][i] = node * cores_per_node[node] + i;
        }
#endif
    }
    
    void bind_to_numa_node(int node) {
#ifdef __linux__
        if (node >= total_numa_nodes) {
            printf("⚠️  Invalid NUMA node %d (max: %d)\n", node, total_numa_nodes - 1);
            return;
        }
        
        cpu_set_t mask;
        CPU_ZERO(&mask);
        
        // Bind to physical cores of this NUMA node
        for (int cpu : physical_cores_per_node[node]) {
            CPU_SET(cpu, &mask);
        }
        
        if (sched_setaffinity(0, sizeof(mask), &mask) != 0) {
            printf("⚠️  Failed to set CPU affinity to NUMA node %d\n", node);
        } else {
            printf("✅ CPU affinity set to NUMA node %d (%d physical cores)\n", 
                   node, (int)physical_cores_per_node[node].size());
        }
#endif
    }
    
    void clear_cpu_affinity() {
#ifdef __linux__
        cpu_set_t mask;
        CPU_ZERO(&mask);
        
        // Allow all physical cores across all NUMA nodes
        for (int node = 0; node < total_numa_nodes; node++) {
            for (int cpu : physical_cores_per_node[node]) {
                CPU_SET(cpu, &mask);
            }
        }
        
        if (sched_setaffinity(0, sizeof(mask), &mask) != 0) {
            printf("⚠️  Failed to clear CPU affinity\n");
        } else {
            printf("✅ CPU affinity cleared (all %d physical cores available)\n", get_total_physical_cores());
        }
#endif
    }
    
    int get_numa_node_count() const { return total_numa_nodes; }
    
    int get_cores_for_node(int node) const {
        if (node >= 0 && node < (int)cores_per_node.size()) {
            return cores_per_node[node];
        }
        return 0;
    }
    
    // Get physical cores count for a node (excluding hyperthreading)
    int get_physical_cores_for_node(int node) const {
        if (node >= 0 && node < (int)physical_cores_per_node.size()) {
            return physical_cores_per_node[node].size();
        }
        return get_cores_for_node(node); // Fallback to all cores
    }
    
    // Get logical cores count for a node (including hyperthreading)
    int get_logical_cores_for_node(int node) const {
        // This would be the total CPU count for the node
        if (node >= 0 && node < total_numa_nodes) {
            std::ifstream cpulist_file("/sys/devices/system/node/node" + std::to_string(node) + "/cpulist");
            if (cpulist_file.is_open()) {
                std::string cpulist;
                std::getline(cpulist_file, cpulist);
                cpulist_file.close();
                
                // Parse cpulist to count CPUs (format: "0-3,8-11" or "0,1,2,3")
                int cpu_count = 0;
                std::istringstream ss(cpulist);
                std::string range;
                while (std::getline(ss, range, ',')) {
                    if (range.find('-') != std::string::npos) {
                        // Range format: "0-3"
                        int start = std::stoi(range.substr(0, range.find('-')));
                        int end = std::stoi(range.substr(range.find('-') + 1));
                        cpu_count += (end - start + 1);
                    } else {
                        // Single CPU: "0"
                        cpu_count++;
                    }
                }
                return cpu_count;
            }
        }
        return get_cores_for_node(node); // Fallback to physical cores
    }
    
    int get_total_physical_cores() const {
        int total = 0;
        for (int cores : cores_per_node) total += cores;
        return total;
    }
    
    int get_total_logical_cores() const {
        int total = 0;
        for (int node = 0; node < total_numa_nodes; node++) {
            total += get_logical_cores_for_node(node);
        }
        return total;
    }
    
    std::string get_topology_summary() const {
        std::string summary = "NUMA Topology: ";
        for (int i = 0; i < total_numa_nodes; i++) {
            if (i > 0) summary += ", ";
            summary += "Node " + std::to_string(i) + " (" + std::to_string(cores_per_node[i]) + " cores)";
        }
        return summary;
    }
};

static const TestConfig test_configs[] = {
    // ADD operation tests - Element-wise addition (currently implemented)
    {"ADD_SMALL",    NumaOperationType::ADD, 128, 128, 16,    "ADD: Small tensor (4 MB)"},
    {"ADD_MEDIUM",   NumaOperationType::ADD, 256, 256, 16,    "ADD: Medium tensor (16 MB)"},
    {"ADD_LARGE",    NumaOperationType::ADD, 512, 256, 64,    "ADD: Large tensor (64 MB)"},
    {"ADD_HUGE",     NumaOperationType::ADD, 1024, 1024, 256, "ADD: Huge tensor (1 GB) - Should force data-parallel"},
    
    // Very large tensor tests - Only run when not in quick mode
    {"ADD_MASSIVE_2GB",  NumaOperationType::ADD, 1448, 1448, 256, "ADD: Massive tensor (2 GB) - Multi-node stress test"},
    {"ADD_MASSIVE_4GB",  NumaOperationType::ADD, 2048, 1024, 512, "ADD: Massive tensor (4 GB) - Multi-node stress test"},  
    {"ADD_MASSIVE_8GB",  NumaOperationType::ADD, 2048, 2048, 512, "ADD: Massive tensor (8 GB) - Multi-node stress test"},
    {"ADD_MASSIVE_16GB", NumaOperationType::ADD, 2896, 2896, 256, "ADD: Massive tensor (16 GB) - Multi-node stress test"}
};

class NumaExecutionModesTest {
private:
    NumaTopologyDetector topology;
    UpiTrafficMonitor upi_monitor;
    std::vector<TestResult> test_results;  // Store results for scaling table
    bool use_physical_cores_only = false;  // Flag to use only physical cores (exclude hyperthreading)
    
    // Clear page cache to ensure fair performance comparison
    void clear_page_cache() {
        printf("      🗑️  Clearing page cache...\n");
        
        // Sync to flush any pending writes
        sync();
        
        // Use sudo to clear page cache, dentries, and inodes
        int result = system("sudo sh -c 'echo 3 > /proc/sys/vm/drop_caches'");
        if (result == 0) {
            printf("      ✅ Page cache cleared successfully\n");
        } else {
            printf("      ⚠️  Page cache clear failed (continuing anyway)\n");
        }
        
        // Small delay to ensure cache clearing takes effect
        usleep(100000); // 100ms
    }
    
public:
    NumaExecutionModesTest() {
        printf("🔍 Initializing NUMA topology detection...\n");
        printf("✅ %s\n", topology.get_topology_summary().c_str());
        
        // Initialize UPI traffic monitoring
        if (!upi_monitor.initialize()) {
            printf("⚠️  UPI traffic monitoring not available (proceeding without UPI validation)\n");
        } else {
            printf("✅ UPI traffic monitoring initialized\n");
        }
    }
    
    // Check if operation is currently supported by NUMA kernels
    bool is_operation_supported(NumaOperationType operation) {
        switch (operation) {
            case NumaOperationType::ADD:
                return true;  // ADD kernel is implemented
            default:
                return false;
        }
    }
    
    // Operation factory methods - creates tensors and operation based on type
    struct OperationSetup {
        ggml_tensor* tensor_a;
        ggml_tensor* tensor_b;
        ggml_tensor* result;
        std::string operation_name;
    };
    
    OperationSetup create_operation(struct ggml_context* ctx, const TestConfig& config) {
        OperationSetup setup = {nullptr, nullptr, nullptr, ""};
        
        switch (config.operation) {
            case NumaOperationType::ADD: {
                setup.tensor_a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, config.dim1, config.dim2, config.dim3);
                setup.tensor_b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, config.dim1, config.dim2, config.dim3);
                setup.result = ggml_add(ctx, setup.tensor_a, setup.tensor_b);
                setup.operation_name = "ADD";
                break;
            }
            default:
                printf("❌ Unsupported operation type\n");
                break;
        }
        
        return setup;
    }
    
    void initialize_operation_data(const OperationSetup& setup, const TestConfig& config) {
        switch (config.operation) {
            case NumaOperationType::ADD: {
                float* a_data = (float*)ggml_get_data(setup.tensor_a);
                float* b_data = (float*)ggml_get_data(setup.tensor_b);
                size_t total_elements = ggml_nelements(setup.tensor_a);
                
                for (size_t i = 0; i < total_elements; i++) {
                    a_data[i] = 1.5f + (i % 100) * 0.01f;
                    b_data[i] = 2.5f + (i % 100) * 0.01f;
                }
                break;
            }
            default:
                printf("❌ Unsupported operation type for data initialization\n");
                break;
        }
    }
    
    // Generic NUMA node isolation test
    double test_numa_isolate_node_impl(const TestConfig& config, int target_node) {
        int node_cores = use_physical_cores_only ? 
            topology.get_physical_cores_for_node(target_node) : 
            topology.get_logical_cores_for_node(target_node);
        printf("\n🔹 NUMA Isolate (Node %d only, %d %s)\n", target_node, node_cores, 
               use_physical_cores_only ? "physical cores" : "logical cores");
        printf("      📍 Using NUMA coordinator with ISOLATE strategy on node %d\n", target_node);
        
        // Clear CPU affinity first
        topology.clear_cpu_affinity();
        
        // Bind to target node BEFORE NUMA initialization for ISOLATE mode
        topology.bind_to_numa_node(target_node);
        
        // Initialize NUMA with ISOLATE strategy specifying target node explicitly
        ggml_numa_init_with_node(GGML_NUMA_STRATEGY_ISOLATE, target_node);
        printf("      ✅ NUMA coordinator initialized with ISOLATE strategy for node %d\n", target_node);
        
        // CRITICAL VERIFICATION: Check that NUMA strategy was set correctly
        enum ggml_numa_strategy actual_strategy = (enum ggml_numa_strategy)ggml_numa_get_strategy();
        int actual_isolate_node = ggml_numa_get_isolate_node();
        
        if (actual_strategy != GGML_NUMA_STRATEGY_ISOLATE) {
            printf("❌ ASSERTION FAILED: Expected ISOLATE strategy (%d), got %d\n", 
                   GGML_NUMA_STRATEGY_ISOLATE, actual_strategy);
            return -1.0;
        }
        
        if (actual_isolate_node != target_node) {
            printf("❌ ASSERTION FAILED: Expected isolate node %d, got %d\n", 
                   target_node, actual_isolate_node);
            return -1.0;
        }
        
        printf("      ✅ VERIFIED: Strategy=%d (ISOLATE), isolate_node=%d\n", 
               actual_strategy, actual_isolate_node);
        
        // CRITICAL VERIFICATION: Check coordinator reports correct number of nodes
        int reported_nodes = ggml_numa_simple_coordinator_get_num_nodes();
        if (reported_nodes != 1) {
            printf("❌ ASSERTION FAILED: ISOLATE mode should report 1 node, got %d\n", reported_nodes);
            return -1.0;
        }
        printf("      ✅ VERIFIED: Coordinator reports %d nodes (correct for ISOLATE)\n", reported_nodes);
        
        // Force single-node execution by setting environment
        setenv("GGML_NUMA_NODES", "1", 1);
        printf("      🔧 NUMA coordinator: ISOLATE mode, node %d only\n", target_node);
        
        size_t tensor_size = (size_t)config.dim1 * config.dim2 * config.dim3 * sizeof(float);
        // Use reasonable context size: 3x tensor size for the 3 tensors + 1GB overhead
        size_t ctx_size = tensor_size * 3 + 1024*1024*1024;
        
        struct ggml_init_params params = {
            /*.mem_size   =*/ ctx_size,
            /*.mem_buffer =*/ NULL,
            /*.no_alloc   =*/ false,
        };
        
        struct ggml_context* ctx = ggml_init(params);
        if (!ctx) {
            printf("❌ Failed to create context\n");
            return -1.0;
        }
        
        // Create operation based on config type
        OperationSetup op = create_operation(ctx, config);
        
        if (!op.tensor_a || !op.result || (config.operation == NumaOperationType::ADD && !op.tensor_b)) {
            printf("❌ Failed to create tensors for %s operation\n", op.operation_name.c_str());
            ggml_free(ctx);
            return -1.0;
        }
        
        // Initialize data based on operation type
        initialize_operation_data(op, config);
        
        struct ggml_cgraph* cgraph = ggml_new_graph(ctx);
        ggml_build_forward_expand(cgraph, op.result);
        
        printf("      Using %d cores (NUMA ISOLATE node %d only) for %s operation\n", 
               node_cores, target_node, op.operation_name.c_str());
        
        // Use NUMA coordinator execution instead of fallback
        printf("      🔧 DEBUG: Using NUMA coordinator execution (ISOLATE mode)\n");
        
        // Warmup
        for (int i = 0; i < 3; i++) {
            enum ggml_status warmup_status = ggml_graph_compute_with_ctx(ctx, cgraph, node_cores);
            printf("      🔧 DEBUG: Warmup %d status: %d\n", i+1, warmup_status);
        }
        
        const int num_runs = 10;
        std::vector<double> times;
        
        for (int run = 0; run < num_runs; run++) {
            auto start = std::chrono::high_resolution_clock::now();
        enum ggml_status status = ggml_graph_compute_with_ctx(ctx, cgraph, node_cores);
        auto end = std::chrono::high_resolution_clock::now();
        
        if (status != GGML_STATUS_SUCCESS) {
            printf("❌ NUMA computation failed\n");
            ggml_free(ctx);
            return -1.0;
        }            double time_ms = std::chrono::duration<double, std::milli>(end - start).count();
            if (time_ms > 0.001) {
                times.push_back(time_ms);
            }
        }
        
        ggml_free(ctx);
        
        if (times.empty()) {
            return -1.0;
        }
        
        std::sort(times.begin(), times.end());
        if (times.size() > 4) {
            times.erase(times.begin());
            times.pop_back();
        }
        
        double avg_time = 0.0;
        for (double t : times) {
            avg_time += t;
        }
        avg_time /= times.size();
        
        printf("      ✅ Average time: %.3f ms\n", avg_time);
        
        return avg_time;
    }
    
    // NUMA Mirror mode test (all nodes together)
    double test_numa_mirror_impl(const TestConfig& config) {
        int total_cores = use_physical_cores_only ? 
            topology.get_total_physical_cores() : 
            topology.get_total_logical_cores();
        int numa_nodes = topology.get_numa_node_count();
        printf("\n🔹 NUMA Mirror (All %d nodes, %d total %s)\n", numa_nodes, total_cores,
               use_physical_cores_only ? "physical cores" : "logical cores");
        printf("      📍 Using NUMA coordinator with MIRROR strategy across all nodes\n");
        
        // Clear CPU affinity first
        topology.clear_cpu_affinity();
        
        // Initialize NUMA with MIRROR strategy across all nodes
        ggml_numa_init(GGML_NUMA_STRATEGY_MIRROR);
        printf("      ✅ NUMA coordinator initialized with MIRROR strategy\n");
        
        // CRITICAL VERIFICATION: Check that NUMA strategy was set correctly
        enum ggml_numa_strategy actual_strategy = (enum ggml_numa_strategy)ggml_numa_get_strategy();
        int actual_isolate_node = ggml_numa_get_isolate_node();
        
        if (actual_strategy != GGML_NUMA_STRATEGY_MIRROR) {
            printf("❌ ASSERTION FAILED: Expected MIRROR strategy (%d), got %d\n", 
                   GGML_NUMA_STRATEGY_MIRROR, actual_strategy);
            return -1.0;
        }
        
        // In mirror mode, isolate_node should be -1 (not applicable)
        if (actual_isolate_node != -1) {
            printf("⚠️  WARNING: In MIRROR mode, isolate_node should be -1, got %d\n", 
                   actual_isolate_node);
        }
        
        printf("      ✅ VERIFIED: Strategy=%d (MIRROR), isolate_node=%d\n", 
               actual_strategy, actual_isolate_node);
        
        // CRITICAL VERIFICATION: Check coordinator reports correct number of nodes
        int reported_nodes = ggml_numa_simple_coordinator_get_num_nodes();
        if (reported_nodes != numa_nodes) {
            printf("❌ ASSERTION FAILED: MIRROR mode should report %d nodes, got %d\n", 
                   numa_nodes, reported_nodes);
            return -1.0;
        }
        printf("      ✅ VERIFIED: Coordinator reports %d nodes (correct for MIRROR)\n", reported_nodes);
        
        // Enable multi-node execution
        char numa_nodes_str[16];
        snprintf(numa_nodes_str, sizeof(numa_nodes_str), "%d", numa_nodes);
        setenv("GGML_NUMA_NODES", numa_nodes_str, 1);
        printf("      🔧 NUMA coordinator: MIRROR mode, %d nodes\n", numa_nodes);
        
        size_t tensor_size = (size_t)config.dim1 * config.dim2 * config.dim3 * sizeof(float);
        // Use reasonable context size: 3x tensor size for the 3 tensors + 1GB overhead
        size_t ctx_size = tensor_size * 3 + 1024*1024*1024;
        
        struct ggml_init_params params = {
            /*.mem_size   =*/ ctx_size,
            /*.mem_buffer =*/ NULL,
            /*.no_alloc   =*/ false,
        };
        
        struct ggml_context* ctx = ggml_init(params);
        if (!ctx) {
            printf("❌ Failed to create context\n");
            return -1.0;
        }
        
        // Create operation based on config type
        OperationSetup op = create_operation(ctx, config);
        
        if (!op.tensor_a || !op.result || (config.operation == NumaOperationType::ADD && !op.tensor_b)) {
            printf("❌ Failed to create tensors for %s operation\n", op.operation_name.c_str());
            ggml_free(ctx);
            return -1.0;
        }
        
        // Initialize data based on operation type
        initialize_operation_data(op, config);
        
        struct ggml_cgraph* cgraph = ggml_new_graph(ctx);
        ggml_build_forward_expand(cgraph, op.result);
        
        printf("      🔧 Using NUMA coordinator with data-parallel execution (%d cores) for %s operation\n", 
               total_cores, op.operation_name.c_str());
        printf("      🔧 DEBUG: NUMA Mirror - will call ggml_graph_compute_with_ctx() with all nodes\n");
        
        // Warmup
        for (int i = 0; i < 3; i++) {
            enum ggml_status warmup_status = ggml_graph_compute_with_ctx(ctx, cgraph, total_cores);
            printf("      🔧 DEBUG: Warmup %d status: %d\n", i+1, warmup_status);
        }
        
        const int num_runs = 10;
        std::vector<double> times;
        
        for (int run = 0; run < num_runs; run++) {
            auto start = std::chrono::high_resolution_clock::now();
            enum ggml_status status = ggml_graph_compute_with_ctx(ctx, cgraph, total_cores);
            auto end = std::chrono::high_resolution_clock::now();
            
            if (status != GGML_STATUS_SUCCESS) {
                printf("❌ NUMA computation failed\n");
                ggml_free(ctx);
                return -1.0;
            }
            
            double time_ms = std::chrono::duration<double, std::milli>(end - start).count();
            if (time_ms > 0.001) {
                times.push_back(time_ms);
            }
        }
        
        ggml_free(ctx);
        
        if (times.empty()) {
            return -1.0;
        }
        
        std::sort(times.begin(), times.end());
        if (times.size() > 4) {
            times.erase(times.begin());
            times.pop_back();
        }
        
        double avg_time = 0.0;
        for (double t : times) {
            avg_time += t;
        }
        avg_time /= times.size();
        
        printf("      ✅ Average time: %.3f ms\n", avg_time);
        return avg_time;
    }
    double run_test_with_upi_monitoring(const TestConfig& /* config */, const std::string& mode_name,
                                       std::function<double()> test_function) {
        printf("\n🔍 Starting UPI monitoring for %s\n", mode_name.c_str());
        
        // Clear page cache before each test for fair comparison
        clear_page_cache();
        
        // Take baseline UPI snapshot
        auto upi_before = upi_monitor.take_snapshot();
        
        // Run the actual test
        double execution_time = test_function();
        
        // Take post-execution UPI snapshot
        auto upi_after = upi_monitor.take_snapshot();
        
        // Validate UPI traffic (5% threshold)
        bool upi_valid = upi_monitor.validate_numa_optimization(upi_before, upi_after, 5.0);
        
        // Print UPI report
        std::string upi_report = upi_monitor.get_traffic_report(upi_before, upi_after);
        printf("%s", upi_report.c_str());
        
        if (!upi_valid) {
            printf("❌ UPI VALIDATION FAILED: Cross-node traffic exceeded 5%% threshold!\n");
            printf("   This indicates NUMA optimizations are not effective.\n");
            return -1.0;  // Fail the test
        } else {
            printf("✅ UPI validation passed: Cross-node traffic within acceptable limits\n");
        }
        
        return execution_time;
    }
    

    void print_scaling_analysis_table() {
        if (test_results.empty()) {
            printf("\n⚠️  No test results available for scaling analysis\n");
            return;
        }
        
        printf("\n╔════════════════════════════════════════════════════════════════╗\n");
        printf("║                     NUMA SCALING ANALYSIS TABLE               ║\n");
        printf("╚════════════════════════════════════════════════════════════════╝\n");
        
        int numa_nodes = topology.get_numa_node_count();
        
        // Dynamic table header
        printf("┌─────────────┬─────────");
        for (int node = 0; node < numa_nodes; node++) {
            printf("┬─────────────");
        }
        printf("┬─────────────┬─────────────┬─────────────┐\n");
        
        printf("│ Config      │ Size    ");
        for (int node = 0; node < numa_nodes; node++) {
            printf("│   Node %d    ", node);
        }
        printf("│   Mirror    │ Best Ratio  │ Efficiency  │\n");
        
        printf("│             │ (GB)    ");
        for (int node = 0; node < numa_nodes; node++) {
            printf("│    (ms)     ");
        }
        printf("│    (ms)     │ vs Single   │   (%%)       │\n");
        
        printf("├─────────────┼─────────");
        for (int node = 0; node < numa_nodes; node++) {
            printf("┼─────────────");
        }
        printf("┼─────────────┼─────────────┼─────────────┤\n");
        
        // Table rows
        for (const auto& result : test_results) {
            printf("│ %-11s │ %7.3f ",
                   result.config_name.c_str(),
                   result.size_gb);
            
            for (int node = 0; node < numa_nodes; node++) {
                if (node < (int)result.isolate_times_ms.size() && result.isolate_times_ms[node] > 0) {
                    printf("│ %11.1f ", result.isolate_times_ms[node]);
                } else {
                    printf("│     FAILED  ");
                }
            }
            
            if (result.mirror_time_ms > 0) {
                printf("│ %11.1f │ %11.2fx │ %11.1f │\n",
                       result.mirror_time_ms,
                       result.mirror_vs_best_ratio,
                       result.numa_scaling_efficiency * 100);
            } else {
                printf("│     FAILED  │     N/A     │     N/A     │\n");
            }
        }
        
        printf("└─────────────┴─────────");
        for (int node = 0; node < numa_nodes; node++) {
            printf("┴─────────────");
        }
        printf("┴─────────────┴─────────────┴─────────────┘\n");
    }
    
    void run_comparison(const std::string& operation_filter = "", 
                        bool use_physical_cores_only = false,
                        bool verbose = false,
                        bool quick = false) {
        // Store the flag for use in test methods
        this->use_physical_cores_only = use_physical_cores_only;
        
        // Suppress unused parameter warnings
        (void)verbose; // TODO: Implement verbose mode
        
        // Enable NUMA debug logging
        setenv("GGML_DEBUG", "1", 1);
        setenv("NUMA_DEBUG", "1", 1);
        
        printf("🎯 NUMA EXECUTION MODES COMPARISON\n");
        printf("=====================================\n");
        printf("System: Dynamic NUMA Detection (%d NUMA nodes)\n", topology.get_numa_node_count());
        if (use_physical_cores_only) {
            printf("Core Usage: Physical cores only (hyperthreading disabled) - %d cores total\n", 
                   topology.get_total_physical_cores());
        } else {
            printf("Core Usage: All available cores (including hyperthreading) - %d cores total\n", 
                   topology.get_total_logical_cores());
        }
        if (!operation_filter.empty()) {
            printf("Operation Filter: %s\n", operation_filter.c_str());
        }
        printf("\n");
        
        for (const auto& config : test_configs) {
            // Skip configurations that don't match the operation filter
            if (!operation_filter.empty()) {
                std::string config_op = operation_type_to_string(config.operation);
                if (config_op != operation_filter) {
                    continue;
                }
            }
            
            // Quick mode: reduce test configurations
            if (quick && (std::string(config.name).find("MEDIUM") != std::string::npos ||
                          std::string(config.name).find("MASSIVE") != std::string::npos)) {
                continue; // Skip medium-sized and massive tests in quick mode
            }
            
            printf("\n📊 Testing %s: %s [%dx%dx%d]\n", 
                   config.name, config.description, config.dim1, config.dim2, config.dim3);
            printf("================================================\n");
            
            // Check if operation is supported by NUMA kernels
            if (!is_operation_supported(config.operation)) {
                printf("⚠️  Skipping %s: NUMA kernel not yet implemented\n", config.name);
                printf("   💡 To enable: Implement NUMA kernel for this operation type\n");
                continue;
            }
            
            TestResult result;
            result.config_name = config.name;
            result.description = config.description;
            result.size_gb = ((double)config.dim1 * config.dim2 * config.dim3 * sizeof(float)) / (1024.0 * 1024.0 * 1024.0);
            
            // Test each NUMA node in isolation
            int numa_nodes = topology.get_numa_node_count();
            result.isolate_times_ms.resize(numa_nodes, -1.0);
            result.isolate_ratios.resize(numa_nodes, -1.0);
            
            for (int node = 0; node < numa_nodes; node++) {
                double isolate_time = run_test_with_upi_monitoring(config, 
                    std::string("NUMA Isolate Node ") + std::to_string(node), 
                    [this, &config, node]() { return test_numa_isolate_node_impl(config, node); });
                    
                if (isolate_time > 0) {
                    result.isolate_times_ms[node] = isolate_time;
                    printf("  Node %d Isolate: %.3f ms\n", node, isolate_time);
                }
            }
            
            // Test mirror mode (all nodes)
            result.mirror_time_ms = run_test_with_upi_monitoring(config, "NUMA Mirror Mode",
                [this, &config]() { return test_numa_mirror_impl(config); });
                
            if (result.mirror_time_ms > 0) {
                printf("  Mirror Mode: %.3f ms\n", result.mirror_time_ms);
            }
            
            // Calculate performance ratios
            double best_isolate_time = std::numeric_limits<double>::max();
            for (int node = 0; node < numa_nodes; node++) {
                if (result.isolate_times_ms[node] > 0) {
                    best_isolate_time = std::min(best_isolate_time, result.isolate_times_ms[node]);
                }
            }
            
            if (best_isolate_time < std::numeric_limits<double>::max() && result.mirror_time_ms > 0) {
                result.mirror_vs_best_ratio = best_isolate_time / result.mirror_time_ms;
                result.numa_scaling_efficiency = result.mirror_vs_best_ratio / numa_nodes;
                
                printf("  Mirror vs Best Single: %.2fx speedup\n", result.mirror_vs_best_ratio);
                printf("  NUMA Scaling Efficiency: %.1f%%\n", result.numa_scaling_efficiency * 100);
            }
            
            test_results.push_back(result);
        }
        
        printf("\n╔════════════════════════════════════════════════════════════════╗\n");
        printf("║                    EXECUTION MODES COMPARISON                 ║\n");
        printf("╚════════════════════════════════════════════════════════════════╝\n");
        
        int numa_nodes = topology.get_numa_node_count();
        printf("Detected NUMA Topology: %d NUMA nodes\n", numa_nodes);
        for (int node = 0; node < numa_nodes; node++) {
            if (use_physical_cores_only) {
                int physical_cores = topology.get_physical_cores_for_node(node);
                printf("  NUMA Node %d: %d physical cores\n", node, physical_cores);
            } else {
                int logical_cores = topology.get_logical_cores_for_node(node);
                int physical_cores = topology.get_physical_cores_for_node(node);
                printf("  NUMA Node %d: %d logical cores (%d physical)\n", node, logical_cores, physical_cores);
            }
        }
        printf("Mirror Mode: All %d nodes coordinated\n", numa_nodes);
        
        // Print comprehensive scaling analysis table
        print_scaling_analysis_table();
        
        printf("\n╔════════════════════════════════════════════════════════════════╗\n");
        printf("║                    DIAGNOSTIC EXPECTATIONS                    ║\n");
        printf("╚════════════════════════════════════════════════════════════════╝\n");
        printf("Expected Performance (Multi-NUMA System):\n");
        printf("• Similar performance across individual NUMA nodes\n");
        printf("• Mirror mode: ~%.1fx speedup over single node (ideal case)\n", (double)numa_nodes);
        printf("• Scaling efficiency depends on memory bandwidth and UPI overhead\n");
        printf("\nDiagnostics:\n");
        printf("• Large node variation: Memory/core asymmetry detected\n");
        printf("• Poor mirror scaling: UPI bottleneck or memory locality issues\n");
    }
};

int main(int argc, char* argv[]) {
    bool use_physical_cores_only = false;
    std::string operation_filter = "";
    bool verbose = false;
    bool quick = false;
    
    // Parse command line arguments
    for (int i = 1; i < argc; i++) {
        std::string arg = argv[i];
        if (arg == "--no-hyperthreading" || arg == "--physical-cores-only") {
            use_physical_cores_only = true;
        } else if (arg.substr(0, 12) == "--operation=") {
            operation_filter = arg.substr(12);
        } else if (arg == "--verbose") {
            verbose = true;
        } else if (arg == "--quick") {
            quick = true;
        } else if (arg == "--help" || arg == "-h") {
            printf("Usage: %s [options]\n", argv[0]);
            printf("\n");
            printf("NUMA Execution Modes Performance Test\n");
            printf("Tests NUMA kernel performance across different execution strategies\n");
            printf("\n");
            printf("Options:\n");
            printf("  --operation=OP            Test only specific operation (ADD)\n");
            printf("  --no-hyperthreading       Use only physical cores, exclude hyperthreading\n");
            printf("  --physical-cores-only     Same as --no-hyperthreading\n");
            printf("  --verbose                 Show detailed test output\n");
            printf("  --quick                   Run reduced test suite for faster results\n");
            printf("  --help, -h                Show this help message\n");
            printf("\n");
            printf("Examples:\n");
            printf("  %s                               # Run all operations\n", argv[0]);
            printf("  %s --operation=ADD               # Test only ADD operation\n", argv[0]);
            printf("  %s --no-hyperthreading           # Use only physical cores\n", argv[0]);
            printf("  %s --operation=ADD --no-hyperthreading  # ADD operation, physical cores only\n", argv[0]);
            return 0;
        } else {
            printf("Unknown option: %s\n", arg.c_str());
            printf("Use --help for usage information.\n");
            return 1;
        }
    }
    
    NumaExecutionModesTest test;
    test.run_comparison(operation_filter, use_physical_cores_only, verbose, quick);
    return 0;
}
